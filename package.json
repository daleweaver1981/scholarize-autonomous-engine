{
  "name": "scholarnet-autonomous-engine",
  "version": "1.0.0",
  "type": "module",
  "description": "Self-improving autonomous engine for ScholarNet",
  "main": "master-orchestrator.js",
  "scripts": {
    "start": "node master-orchestrator.js",
    "test": "node test-ai-evolution.js",
    "test:orchestrator": "node test-orchestrator.js",
    "test:content": "node test-content-engine.js",
    "test:seo": "node test-seo-engine.js",
    "test:social": "node test-social-engine.js",
    "test:all": "npm test && npm run test:orchestrator && npm run test:content && npm run test:seo && npm run test:social",
    "orchestrator:dev": "node master-orchestrator.js",
    "orchestrator:start": "pm2 start ecosystem.config.js",
    "orchestrator:stop": "pm2 stop scholarnet-orchestrator",
    "orchestrator:restart": "pm2 restart scholarnet-orchestrator",
    "orchestrator:logs": "pm2 logs scholarnet-orchestrator",
    "orchestrator:status": "pm2 status",
    "health": "curl -s http://localhost:3100/health | json_pp || echo 'Orchestrator not running'"
  },
  "keywords": [
    "autonomous",
    "ai",
    "evolution",
    "orchestrator"
  ],
  "author": "ScholarNet Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "axios": "^1.13.5",
    "dotenv": "^16.6.1",
    "ioredis": "^5.3.2",
    "node-cron": "^3.0.3",
    "openai": "^6.22.0",
    "pg": "^8.11.3"
  }
}
